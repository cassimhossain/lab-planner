{
  "name": "robotics-club-lab",
  "productName": "BotBench",
  "version": "1.1.0",
  "description": "Robotics & AI Club: the lesson portal, Circuit Lab and Code Lab as a desktop app",
  "author": "Qasim Mushtaq",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "site": "node copy-site.js",
    "start": "npm run site && electron .",
    "mac": "npm run site && electron-builder --mac dmg --arm64 --x64",
    "win": "LAB_MODE=circuit node copy-site.js && electron-builder --win nsis --x64 -c.extraMetadata.labMode=circuit -c.extraMetadata.productName='BotBench Circuits' -c.productName='BotBench Circuits' -c.appId=io.github.cassimhossain.circuitlab -c.win.icon=icon-circuit.ico -c.nsis.shortcutName='BotBench Circuits' -c.nsis.installerIcon=icon-circuit.ico -c.nsis.uninstallerIcon=icon-circuit.ico '-c.artifactName=BotBench-Circuits-${version}-win-${arch}.${ext}'"
  },
  "build": {
    "appId": "io.github.cassimhossain.labplanner",
    "productName": "BotBench",
    "copyright": "Robotics & AI Club \u00b7 Qasim Mushtaq",
    "files": [
      "main.js",
      "icon.png",
      "icon-circuit.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "site",
        "to": "site"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "BotBench-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "icon-mac.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "BotBench"
    },
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BotBench",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "labMode": "full"
}
